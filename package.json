{
  "name": "@cinatra-ai/screenshot-artifact",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.0.0"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "displayName": "Screenshot",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/screenshot-matcher-skill",
        "kind": "skill",
        "role": "matcher",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "required"
      }
    ],
    "artifact": {
      "accepts": {
        "file": {
          "mimeTypes": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        }
      },
      "ui": {
        "abiVersion": 1,
        "sdkAbiRange": "^2.5.0",
        "renderers": {
          "detail": {
            "entry": "./src/renderers/detail.tsx",
            "propsApiVersion": 2,
            "representations": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          }
        }
      },
      "objectTypes": [
        {
          "type": "@cinatra-ai/screenshot-artifact:screenshot",
          "claim": "dedicated",
          "dispositions": {
            "projection": "artifact-safe",
            "pinnable": true,
            "snapshotPolicy": "content",
            "sensitivity": "normal"
          },
          "schema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "mime": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "capturedUrl": {
                "type": "string",
                "format": "uri"
              },
              "viewport": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "capturedAt": {
                "type": "string",
                "format": "date-time"
              },
              "latestRepresentationRevisionId": {
                "type": "string"
              },
              "latestDigest": {
                "type": "string"
              }
            },
            "required": [
              "mime",
              "size"
            ],
            "additionalProperties": true
          }
        }
      ],
      "skills": {
        "matchers": [
          "@cinatra-ai/screenshot-matcher-skill:screenshot-matcher"
        ]
      },
      "matcherConfidenceThreshold": 0.7
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/renderers/detail": {
      "import": "./src/renderers/detail.tsx",
      "default": "./src/renderers/detail.tsx"
    },
    "./src/renderer-props": {
      "types": "./src/renderer-props.ts",
      "import": "./src/renderer-props.ts",
      "default": "./src/renderer-props.ts"
    }
  }
}
